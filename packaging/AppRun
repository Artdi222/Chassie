#!/bin/sh
# Chassie AppImage entry. The image is read-only, so her data lives in ~/.local/share/chassie.
HERE="$(dirname "$(readlink -f "$0")")"
export CHASSIE_DATA="${CHASSIE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/chassie}"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
[ -f "$HERE/opt/_internal/certs.pem" ] && export SSL_CERT_FILE="${SSL_CERT_FILE:-$HERE/opt/_internal/certs.pem}"
# Chromium's sandbox needs a setuid helper or user namespaces an AppImage may not get; the panels only show local pages.
export QTWEBENGINE_DISABLE_SANDBOX=1
mkdir -p "$CHASSIE_DATA"
exec "$HERE/opt/python3.12/bin/python3.12" "$HERE/opt/chassie/launch.py" "$@"
